APP_NAME=Rates
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8079

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL: credentials match the root .env.example
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=rates
DB_USERNAME=rates
DB_PASSWORD=rates_local_password

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
CACHE_PREFIX=rates_cache_
REDIS_PREFIX=rates_database_

# RabbitMQ: credentials match the root .env.example
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=rates
RABBITMQ_PASSWORD=rates_local_password
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=default

QUEUE_FAILED_DRIVER=database-uuids

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log
